# Assignment No. 6
# Aim: To perform data preprocessing using Pandas

import pandas as pd

# Step 1: Create a sample dataset
data = {
    'Name': ['Amit', 'Priya', 'Rahul', 'Sneha', 'Amit', 'Karan'],
    'Marks': [85, 90, None, 78, 85, None],
    'City': ['Pune', 'Mumbai', 'Delhi', None, 'Pune', 'Nashik'],
    'Age': [19, 20, 19, 18, 19, 21]
}

df = pd.DataFrame(data)

print("Original Dataset:")
print(df)

# Step 2: Display the first five records
print("\nFirst Five Records:")
print(df.head())

# Step 3: Display information about the dataset
print("\nDataset Information:")
df.info()

# Step 4: Display statistical information
print("\nStatistical Description:")
print(df.describe())

# Step 5: Check for missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Step 6: Fill missing Marks with the mean
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())

# Fill missing City values with the mode
df['City'] = df['City'].fillna(df['City'].mode()[0])

print("\nDataset After Handling Missing Values:")
print(df)

# Step 7: Check for duplicate records
print("\nDuplicate Records:")
print(df[df.duplicated()])

# Remove duplicate records
df = df.drop_duplicates()

print("\nDataset After Removing Duplicates:")
print(df)

# Step 8: Drop an irrelevant column
df = df.drop(columns=['Age'])

print("\nDataset After Dropping Age Column:")
print(df)

# Step 9: Select specific rows using loc[]
print("\nFirst Three Records:")
print(df.loc[0:2])

# Step 10: Filter students having Marks greater than 80
print("\nStudents Scoring More Than 80 Marks:")
print(df.loc[df['Marks'] > 80])

# Step 11: Save the cleaned dataset to a CSV file
df.to_csv('cleaned_data.csv', index=False)

print("\nPreprocessing Completed Successfully!")
print("Cleaned dataset saved as cleaned_data.csv")
