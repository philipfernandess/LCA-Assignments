   "source": [
    "# Dictionary\n",
    "d = {\"name\": \"ABC\", \"rollno\": 34}\n",
    "print(d)\n",
    "\n",
    "d[\"age\"] = 20       # Add\n",
    "print(d)\n",
    "\n",
    "d[\"name\"] = \"XYZ\"   # Update\n",
    "print(d)\n",
    "\n",
    "d.pop(\"age\")        # Remove\n",
    "print(d)\n",
    "\n",
    "\n",
    "# Tuple\n",
    "t = (10, 20, 30, 40)\n",
    "print(t)\n",
    "\n",
    "t = t + (50,)      # Add\n",
    "print(t)\n",
    "\n",
    "t = t[:2] + t[3:]   #Remove\n",
    "print(t)\n"
   ]
